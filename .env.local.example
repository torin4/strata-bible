# Firebase web config (public by design — safe to expose to the browser).
# Copy to .env.local and fill from: Firebase console -> Project settings ->
# General -> Your apps -> Web app -> SDK setup and configuration -> Config.
# Also set the same values as Environment Variables in the Vercel project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Companion (phase 4) — server only, NOT NEXT_PUBLIC. The Anthropic API key lives only
# on the server route; it never reaches the browser. From console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=

# Stripe / STRATA Plus billing. The publishable key is public (NEXT_PUBLIC). PRICE_ID is
# the recurring price the reader buys, and setting it flips the content gate ON. Create the
# product + price in Stripe (test mode first). The SECRET key (sk_...) and the webhook
# signing secret are NOT here: they go only into the Firebase "Run Payments with Stripe"
# extension config, never the repo.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=
# Optional: the Cloud Functions region the Stripe extension was installed to (default us-central1).
NEXT_PUBLIC_STRIPE_FUNCTIONS_REGION=
# Per-book one-time purchase prices (Stripe one-time price ids). One per book that is sold
# individually; books without one are only reachable through STRATA Plus.
NEXT_PUBLIC_STRIPE_BOOK_GENESIS=
