rules_version = '2';

// Each user can read and write only their own data under users/{uid}/**. Writes are
// constrained per document so a user cannot store arbitrary oversize junk or roll back the
// companion usage counter. Nothing else is accessible. Paste this into the Firebase
// console: Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // Journal entries: a bounded text body plus optional reading context. Capped so a
      // single entry cannot be used as oversize blob storage. No update path is used.
      match /entries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 50000
          && request.resource.data.size() <= 12;
      }

      // Reader state: highlights, progress, prefs, lastRead, companionUsage. Each is a
      // single small document the client merges into. (companionUsage.freeDraws is written
      // with an increment() transform, which security rules cannot validate reliably, so
      // a tamper-proof free-draw cap belongs server-side, not here.)
      match /state/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Companion draft cache: one document per drafted passage, keyed by reading + ref.
      match /companion/{cacheId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Stripe extension ("Run Payments with Stripe"). A reader creates and reads only their
    // own checkout sessions, and reads (never writes) their own synced subscriptions and
    // payments; the extension writes those server-side. The product/price catalog is public.
    match /customers/{uid} {
      allow read: if isOwner(uid);
      match /checkout_sessions/{id} {
        allow read, write: if isOwner(uid);
      }
      match /subscriptions/{id} {
        allow read: if isOwner(uid);
      }
      match /payments/{id} {
        allow read: if isOwner(uid);
      }
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{priceId} {
        allow read: if true;
      }
      match /tax_rates/{taxId} {
        allow read: if true;
      }
    }
  }
}
