rules_version = '2';

// Each user can read and write only their own journal entries. Nothing else is
// accessible. Paste this into the Firebase console: Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
